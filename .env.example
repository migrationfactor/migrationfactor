# -----------------------------------------------------------------------------
# Migration Factor - Environment Configuration Template
# (Copy this file to .env or .env.local and fill in the values)
# -----------------------------------------------------------------------------

# Domain / Site Configuration
DOMAIN_NAME=migrationfactor.com
NEXT_PUBLIC_SITE_URL=https://migrationfactor.com

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Public Client Keys (Safe for Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-Side / Admin Keys (Keep Secret - Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# New-format secret key (sb_secret_...). Used in preference to the service role key when set.
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Database Connection
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# Email / Resend Configuration
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
# Sender must use a domain verified in Resend, e.g. "Migration Factor <noreply@migrationfactor.com>".
# migrationfactor.com is verified in Resend; this is also the default when unset.
RESEND_FROM_EMAIL="Migration Factor <noreply@migrationfactor.com>"
# Where new lead and booking notifications are sent (defaults to info@migrationfactor.com).
ADMIN_NOTIFICATION_EMAIL=info@migrationfactor.com

# -----------------------------------------------------------------------------
# Webhook / Optional Enquiry Settings
# -----------------------------------------------------------------------------
# DATA_DIR=./data
# ENQUIRY_WEBHOOK_URL=https://example.com/api/webhook
# ENQUIRY_WEBHOOK_TOKEN=your-token

# Daily e-signature reminders (vercel.json cron). Vercel sends it as a Bearer token; use 16+ random characters.
CRON_SECRET=
