{
  "name": "migration-factor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "admin:create": "node scripts/create-admin.mjs",
    "db:migrate": "node scripts/migrate-leads.mjs",
    "migrate:wp:inspect": "tsx scripts/wordpress-migration/fetch-posts.ts inspect",
    "migrate:wp:export": "tsx scripts/wordpress-migration/fetch-posts.ts export",
    "migrate:wp:media": "tsx scripts/wordpress-migration/localize-media.ts",
    "migrate:wp:dry-run": "tsx scripts/wordpress-migration/import-posts.ts --dry-run",
    "migrate:wp:import": "tsx scripts/wordpress-migration/import-posts.ts",
    "migrate:wp:verify": "tsx scripts/wordpress-migration/verify-migration.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
